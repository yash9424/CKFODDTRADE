# Public site URL — used for canonical URLs, sitemap.xml and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://ckfoodstuff.com

# ---------------------------------------------------------------------------
# Enquiry delivery. With neither set, every submission is still written to
# data/submissions.jsonl and logged to the server console.
# ---------------------------------------------------------------------------

# Option A — POST each submission as JSON to a webhook (Zapier / Make / CRM).
# FORM_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/000000/abcdef

# Option B — email each submission via Resend (https://resend.com).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# NOTIFY_EMAIL=ckfoodstuff@gmail.com
# NOTIFY_FROM=CK Foodstuff Website <website@ckfoodstuff.com>
